{
  "name": "ample",
  "productName": "Paulatim",
  "version": "1.1.1",
  "description": "A private Windows energy planner for variable-capacity days.",
  "author": "Nicholas Toledo / Toledo Technologies",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:dir": "npm run typecheck && vite build && electron-builder --dir",
    "build:linux": "npm run typecheck && vite build && electron-builder --linux --dir",
    "build:win": "npm run typecheck && vite build && electron-builder --win",
    "build:winstore": "npm run store:require-verified && npm run icons && npm run winstore-assets && npm run typecheck && vite build && electron-builder --win appx",
    "screenshots": "npm run vite:build && node scripts/capture-store-screenshots.mjs",
    "landing:media": "node scripts/sync-landing-media.mjs",
    "winstore-assets": "node scripts/generate-windows-store-assets.mjs",
    "store:check": "node store/identity.cjs --check",
    "store:require-verified": "node store/identity.cjs --require-verified",
    "store:validate": "node scripts/validate-store.mjs",
    "build:mac": "npm run typecheck && vite build && electron-builder --mac",
    "vite:build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "secrets": "node scripts/scan-secrets.mjs",
    "licenses": "node scripts/generate-third-party-notices.mjs",
    "brand-assets": "node scripts/generate-brand-assets.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.8",
    "@fontsource/fraunces": "^5.2.9",
    "@tanstack/react-query": "^5.101.2",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jimp": "^1.6.1",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  }
}
