{
  "name": "hearth",
  "productName": "Hearth",
  "version": "1.0.0",
  "description": "A desktop that adapts to your psychology. Mindful, mental-health-aware life organization.",
  "author": {
    "name": "The Hearth Project",
    "email": "hello@hearthproject.io"
  },
  "homepage": "https://hearthproject.io",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && electron-builder",
    "build:dir": "npm run typecheck && vite build && electron-builder --dir",
    "build:linux": "npm run typecheck && vite build && electron-builder --linux --dir",
    "build:win": "npm run typecheck && vite build && electron-builder --win",
    "build:winstore": "npm run icons && npm run winstore-assets && npm run typecheck && vite build && electron-builder --win appx",
    "winstore-assets": "node scripts/generate-windows-store-assets.mjs",
    "store:check": "node store/identity.cjs --check",
    "build:mac": "npm run typecheck && vite build && electron-builder --mac",
    "vite:build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "framer-motion": "^11.18.0",
    "jimp": "^0.22.12",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
